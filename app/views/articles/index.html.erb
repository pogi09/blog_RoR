<div class="container mt-4">
  <div class="text-center">
    <h1 class="display-4">Articles</h1>
    <p class="lead">Our blog has <strong><%= pluralize(Article.count, 'article') %></strong> and counting!</p>
  </div>

  <div class="row">
    <% @articles.each do |article| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">
              <%= link_to article.title, article_path(article), class: "text-decoration-none" %>
            </h5>
            <p class="card-text"><%= truncate(article.body, length: 100) %></p>
          </div>
          <div class="card-footer text-center">
            <%= link_to "Read more", article_path(article), class: "btn btn-primary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-4">
    <%= link_to "New Article", new_article_path, class: "btn btn-success" %>
  </div>
</div>
<div class="container mt-4">
  <h1 class="mb-4">New Article</h1>

  <%= form_with model: @article, local: true, class: "needs-validation" do |form| %>
    <div class="mb-3">
      <%= form.label :title, class: "form-label" %>
      <%= form.text_field :title, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= form.label :body, class: "form-label" %>
      <%= form.text_area :body, class: "form-control", rows: 5, required: true %>
    </div>

    <%= form.submit "Create Article", class: "btn btn-primary" %>
  <% end %>
</div>